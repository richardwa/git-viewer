[Unit]
Description=App Container

[Container]
Image=app
ContainerName=app
Environment=TZ=America/New_York

Environment=PORT=7845
PublishPort=0.0.0.0:7845:7845

Volume=%h/repos:/REPOS
Environment=REPOS_DIR=/REPOS

# artifacts (build outputs) live outside the repos dir; the viewer reads run
# statuses here and the post-receive hook dedupes against it
Volume=%h/artifacts:/ARTIFACTS
Environment=ARTIFACTS_DIR=/ARTIFACTS

# podman fails to start (statfs error) if a bind-mount source is missing;
# ensure the volumes' host dirs exist first
ExecStartPre=/bin/mkdir -p %h/artifacts %h/repos

# share host ssh keys for push to github.com
Volume=%h/.ssh:/root/.ssh:ro

Environment=ACL_FILE=/app/acl.yaml
Volume=%h/.secrets/acl.yaml:/app/acl.yaml:ro

Volume=%h/certs:/root/certs:ro
Environment=TLS_CERT=/root/certs/cert.pem
Environment=TLS_KEY=/root/certs/key.pem

[Service]
Restart=always

[Install]
WantedBy=default.target

