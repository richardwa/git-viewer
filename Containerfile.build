# Build recipe for git-viewer, driven by the build daemon:
#   podman build -f Containerfile.build -t gitviewer/git-viewer:<branch>-<hash> .
#   podman run --rm -e OUTPUT=/output -v <rundir>:/output gitviewer/git-viewer:...
#
# Artifact shape under $OUTPUT:
#   server/server-bundle.min.js   the server, deps bundled in (run with bun/node)
#   server/dist/                  client bundle served by the server bundle
#   server.zip                    the server/ folder as one downloadable file
#   build.properties              daemon-written build identity (copied into
#                                 server/dist by the run stage so the running
#                                 server serves it statically)
# The build stage is setup (deps + sources); the run stage is the build:
# server typecheck + bundle, then the client bundle emitted into server/dist.
FROM docker.io/oven/bun:1

# zip: bundle the artifact into a single downloadable file
RUN apk add --no-cache zip

WORKDIR /src

# install dependencies first so this layer caches across source changes
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .
CMD ["sh", "-c", "\
  set -e; \
  mkdir -p \"$OUTPUT/server\"; \
  bunx tsc; \
  bun run build:server; \
  cp build/server/server-bundle.min.js \"$OUTPUT/server/server-bundle.min.js\"; \
  bun --bun x vite build --outDir \"$OUTPUT/server/dist\" --emptyOutDir; \
  cp \"$OUTPUT/build.properties\" \"$OUTPUT/server/dist/build.properties\"; \
  cd \"$OUTPUT\" && zip -qr server.zip server"]